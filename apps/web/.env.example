# BIOX web — environment variables
# Copy to .env and fill in. Every VITE_* value is PUBLIC (inlined in the bundle) —
# never put secrets here.

# Base URL of the BIOX API
VITE_API_URL=http://localhost:3333/v1

# Firebase JS SDK (client) — public identifiers, not secrets
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
