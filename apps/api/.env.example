# BIOX API — environment variables
# Copy to .env and fill in. Server-side secrets only: NOTHING here may reach the web bundle.

# Postgres connection string (local: docker-compose postgres, prod: Neon)
DATABASE_URL=postgresql://biox:biox@localhost:5432/biox

# Anthropic — extraction + insights workers. Server only, never in the client or repo.
ANTHROPIC_API_KEY=

# Firebase Admin SDK (service account) — verifies ID tokens in the auth guard
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# PDF storage adapter: "local" (dev) writes to disk, "s3" (prod) targets an
# S3-compatible bucket (Cloudflare R2)
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Web app origin allowed by CORS (dev: Vite default)
APP_ORIGIN=http://localhost:5173

# LGPD two-tier deletion: days between the deletion request and the purge job
PURGE_GRACE_DAYS=7

# HTTP port (defaults to 3333)
PORT=3333
