# Dependencies
node_modules/
.pnp
.pnp.js
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Build outputs
dist/
build/
out/
.next/
.nuxt/
.turbo/
.vite/
*.tsbuildinfo

# Environment variables (never commit secrets)
.env
.env.*
!.env.example

# Clinical / patient data (NEVER commit real PHI/PII)
# Prevention at the source: real lab reports and patient data stay local.
# Anonymization of real data happens in the pipeline documented in data-privacy.md.
private/
uploads/
**/uploads/
data/private/
data/real/
fixtures/real/

# Lab report PDFs — ignore everywhere, allow only curated documentation PDFs
*.pdf
!docs/**/*.pdf

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Testing / coverage
coverage/
.nyc_output/

# Caches
.cache/
.eslintcache
.parcel-cache/

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editors / IDE
.idea/
*.swp
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json

# Claude Code local (machine-specific) settings
.claude/settings.local.json
